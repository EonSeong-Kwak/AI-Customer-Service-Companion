# ===== 阿里云百炼 API Key（加密存储） =====
# 使用项目根目录的 generate_secrets.py 生成加密后的 API Key
DASHSCOPE_API_KEY_ENC='你的加密API Key'

# ===== 数据库连接字符串 =====
# MySQL（生产环境）
# DATABASE_URL=mysql+aiomysql://用户名:密码@主机:端口/数据库名

# SQLite（开发备选）
# DATABASE_URL=sqlite+aiosql:///./backend/local.db

# ===== Redis 连接（可选）=====
# REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT 密钥（生产环境必须修改）=====
# SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION

# ===== JWT 过期时间 =====
# ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天